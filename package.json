{
  "name": "novel-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地 AI 小说创作工作台",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build --base=./ --outDir dist/renderer",
    "start": "electron .",
    "test": "tsc -p tsconfig.tests.json && node --test dist-tests/main/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.54.0",
    "openai": "7.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
